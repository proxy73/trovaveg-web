---
import FaqView from '../components/FaqView.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCopy, site } from '../content/copy';

const copy = getCopy('it');
---

<BaseLayout
  locale="it"
  copy={copy}
  title={copy.faq.metaTitle}
  description={copy.faq.metaDescription}
  canonicalPath="/faq/"
  alternateKey="faq"
>
  <FaqView copy={copy} site={site} />
</BaseLayout>
