---
import CityView from '../../components/CityView.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCopy, site } from '../../content/copy';

const copy = getCopy('en');
---

<BaseLayout
  locale="en"
  copy={copy}
  title={copy.milan.metaTitle}
  description={copy.milan.metaDescription}
  canonicalPath="/en/milan/"
  alternateKey="milan"
>
  <CityView city={copy.milan} site={site} />
</BaseLayout>
